{
  "expo": {
    "name": "oki-app",
    "slug": "oki-app",
    "version": "1.0.0",
    "scheme": "oki",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Oki needs access to your photo library to set your profile picture.",
          "cameraPermission": "Oki needs access to your camera to take a profile photo."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/53647ae6-4e11-41a7-9f55-c58fd6b1b09d"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.okiapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Oki needs access to your photo library to set your profile picture.",
        "NSCameraUsageDescription": "Oki needs access to your camera to take a profile photo."
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.okiapp"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "53647ae6-4e11-41a7-9f55-c58fd6b1b09d"
      }
    }
  }
}
