# ─── App Environment ──────────────────────────────────────────
# Used to configure app behavior per environment
APP_ENV=development

# ─── Supabase ─────────────────────────────────────────────────
# Get these from Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase Vault ───────────────────────────────────────────
# Store the following in Supabase Vault, not in this file:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - SUPABASE_DB_URL (connection string with password)
#   - Any third-party API keys or tokens

# ─── Expo / EAS ──────────────────────────────────────────────
# EAS Project ID (get from Expo Dashboard)
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
