# ─── App Environment ──────────────────────────────────────────
APP_ENV=development

# ─── Supabase (EXPO_PUBLIC_ for client) ───────────────────────
# For Local Development (default Supabase CLI credentials):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# For Production/Staging (Uncomment and replace when targeting remote):
# EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase (server-side / admin) ───────────────────────────
# For Local Development:
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# For Production/Staging (Uncomment and replace when targeting remote):
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here

# ─── Supabase Vault ───────────────────────────────────────────
# Store in Supabase Vault, not in this file:
#   SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL, third-party keys

# ─── Expo / EAS ──────────────────────────────────────────────
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id

# ─── Third-party Services ────────────────────────────────────
# STRIPE_PUBLISHABLE_KEY=
# TWILIO_API_KEY=
# DEEPSEEK_API_KEY=
